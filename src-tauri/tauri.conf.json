{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoyrIDE",
  "version": "0.2.0",
  "identifier": "com.ansiapps.joyride",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JoyrIDE",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "backgroundColor": "#16181d"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "resources": ["resources/toolchains/**/*", "resources/soundfonts/**/*", "../samples/**/*"],
    "copyright": "ansiapps. MIT license.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": { "hardenedRuntime": true }
  }
}
